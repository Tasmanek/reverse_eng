    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="RECZNE_Przetwarzanie_F11" sourceRef="RECZNE_Przetwarzanie_table" targetRef="RECZNE_Przetwarzanie_merge" name="Nie">
