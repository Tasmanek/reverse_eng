  </bpmn:process>
  <bpmn:process id="RECZNE_Konwersje" name="3. Portal — opcjonalne podniesienie oceny po konwersji" isExecutable="false">
    <bpmn:documentation>Model biznesowy ręcznego dodania zasobu w panelu administracyjnym. Podstawa: lokalny snapshot mcod/backend/2.62.3/98b9855d7b47cb8fd8680ab70c6114f138ac46123ea1541fbce2664866f09578-tree; resources/forms.py, admin.py, models.py i tasks. Analiza statyczna, bez uruchamiania aplikacji. Diagram agreguje dwie ścieżki wejścia w pojedynczy krok zgodnie z prośbą użytkownika. Zapis jako szkic nie uruchamia tego samego przebiegu co zapis opublikowanego zasobu.</bpmn:documentation>
    <bpmn:startEvent id="RECZNE_Konwersje_start" name="Odebrano zlecenie konwersji">
      <bpmn:outgoing>RECZNE_Konwersje_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="RECZNE_Konwersje_start_MessageEvent" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="RECZNE_Konwersje_convert" name="Spróbuj utworzyć CSV lub JSON-LD">
      <bpmn:documentation>Resource.increase_openness_score: XLS/XLSX, not is_linked i dane tabeli → CSV. Dostępny CSV poza archiwum → próba JSON-LD. Ręczny URL zewnętrzny oznacza is_linked=True, więc nie dostaje XLSX→CSV. Własny plik z dysku z linkiem wewnętrznym może dostać tę konwersję. Błędy nie gwarantują nowego pliku.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Konwersje_F1</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Konwersje_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Konwersje_created" name="Powstał nowy plik pochodny?" gatewayDirection="Diverging">
      <bpmn:incoming>RECZNE_Konwersje_F2</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Konwersje_F3</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Konwersje_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RECZNE_Konwersje_score" name="PONOWNIE oblicz i zapisz stopień otwartości">
      <bpmn:documentation>Ten sam algorytm: ocena zasobu to maksimum ocen jego plików. Konwersja i pierwsze obliczenie nie mają gwarantowanej kolejności zakończenia.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Konwersje_F3</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Konwersje_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RECZNE_Konwersje_refresh" name="Zleć odświeżenie publikacji z nową oceną">
      <bpmn:documentation>update_es_and_rdf_db; tylko is_published. Pliki pochodne są dostępne na stronie zasobu i w formularzu edycji, gdy istnieją.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Konwersje_F4</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Konwersje_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RECZNE_Konwersje_end" name="Koniec próby konwersji">
      <bpmn:incoming>RECZNE_Konwersje_F5</bpmn:incoming>
      <bpmn:incoming>RECZNE_Konwersje_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F1" sourceRef="RECZNE_Konwersje_start" targetRef="RECZNE_Konwersje_convert" />
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F2" sourceRef="RECZNE_Konwersje_convert" targetRef="RECZNE_Konwersje_created" />
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F3" sourceRef="RECZNE_Konwersje_created" targetRef="RECZNE_Konwersje_score" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F4" sourceRef="RECZNE_Konwersje_score" targetRef="RECZNE_Konwersje_refresh" />
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F5" sourceRef="RECZNE_Konwersje_refresh" targetRef="RECZNE_Konwersje_end" />
    <bpmn:sequenceFlow id="RECZNE_Konwersje_F6" sourceRef="RECZNE_Konwersje_created" targetRef="RECZNE_Konwersje_end" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="RECZNE_Collaboration" name="Ręczne dodanie zasobu — zapis, walidacja i stopnie otwartości">
    <bpmn:participant id="RECZNE_Formularz_Pool" name="Edytor i obsługa formularza" processRef="RECZNE_Formularz" />
    <bpmn:participant id="RECZNE_Przetwarzanie_Pool" name="Portal — przygotowanie zasobu w tle" processRef="RECZNE_Przetwarzanie" />
    <bpmn:participant id="RECZNE_Konwersje_Pool" name="Portal — pliki pochodne w tle" processRef="RECZNE_Konwersje" />
    <bpmn:messageFlow id="RECZNE_Message1" sourceRef="RECZNE_Formularz_send" targetRef="RECZNE_Przetwarzanie_start" name="Zlecenie po zatwierdzeniu zapisu" />
    <bpmn:messageFlow id="RECZNE_Message2" sourceRef="RECZNE_Przetwarzanie_send" targetRef="RECZNE_Konwersje_start" name="Zlecenie po udanej indeksacji; bez oczekiwania" />
  </bpmn:collaboration>
