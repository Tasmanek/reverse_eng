<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="CKAN_Definitions" targetNamespace="https://example.org/harvester/openness" exporter="Codex" exporterVersion="1">
  <bpmn:process id="CKAN_Ocena" name="CKAN — nadanie stopnia otwartości zasobu" isExecutable="false">
    <bpmn:documentation>Odwzorowanie AS-IS raportu ../harvester_walidacje_ckan_xml.html (mcod 2.62.3; raport 2026-11-08). Nie potwierdzono bieżącej produkcji. Model biznesowy niewykonywalny. Ocena dotyczy zasobu, nie wyniku importu ani jakości danych.</bpmn:documentation>
    <bpmn:startEvent id="CKAN_Ocena_start" name="Odebrano zlecenie przygotowania zasobu">
      <bpmn:documentation>Zapis Resource uruchamia sygnał. Nowy publikowany zasób lub zmiana wymagająca przetwarzania → zlecenie po commicie. Sam zapis metadanych nie zawsze przelicza ocenę. Źródło: O2, O3; U-3.</bpmn:documentation>
      <bpmn:outgoing>CKAN_Ocena_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CKAN_Ocena_prep" name="Przygotuj zasób do oceny">
      <bpmn:documentation>CKAN: etap URL nie tworzy kopii głównej; brak kontroli zawartości lokalnego pliku i danych tabeli. Pobranie do oceny jest osobnym krokiem.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F1</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CKAN_Ocena_fmt" name="Format zasobu = brak (None)?" gatewayDirection="Diverging">
      <bpmn:documentation>Brak formatu zasobu → 0. Nie mylić z brakiem formatu pojedynczego pliku → 1. Źródło: O10.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F2</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F3</bpmn:outgoing>
      <bpmn:outgoing>CKAN_Ocena_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CKAN_Ocena_zero" name="Ustal stopień zasobu 0">
      <bpmn:incoming>CKAN_Ocena_F3</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CKAN_Ocena_link" name="Pobierz treść spod linku do oceny">
      <bpmn:documentation>Treść w pamięci; format z bazy (deklaracja CKAN lub wynik wcześniejszego rozpoznania, także U-1). Brak tworzenia pliku głównego i rozpakowywania archiwum. Źródło O12, SC-307.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F11</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="CKAN_Ocena_calc" name="Oblicz stopień według formatu i treści">
      <bpmn:documentation>Źródło: tab=ocena, ROW-ocena-001..003 i SECTION-ocena-7. Rozwinięcie ma własny diagram. Dla linku format pochodzi z bazy; dla pliku jest efektywnym formatem ocenianej zawartości.</bpmn:documentation>
      <bpmn:startEvent id="CKAN_Ocena_calc_start" name="Treść i format do oceny">
        <bpmn:outgoing>CKAN_Ocena_calc_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_format" name="Który format oceniamy?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F1</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F2</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F3</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F4</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_json" name="JSON: odczyt RDF daje niepusty graf?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F2</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F6</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_xml" name="XML: wszystkie elementy mają przestrzenie nazw?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F3</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F10</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_rdf" name="RDF: niepusty graf?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F4</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F14</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CKAN_Ocena_calc_default" name="Inny format: użyj oceny z tabeli">
        <bpmn:documentation>PDF/JPG/TXT → 1; XLS/XLSX → 2; CSV/HTML/ODS → 3; format spoza tabeli → 1. Pełna tabela w raporcie źródłowym.</bpmn:documentation>
        <bpmn:incoming>CKAN_Ocena_calc_F5</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_jlinked" name="Graf łączy różne domeny?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F6</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F8</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_xlinked" name="Poprawny RDF łączy różne domeny?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F10</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F12</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CKAN_Ocena_calc_rlinked" name="Graf łączy różne domeny?" gatewayDirection="Diverging">
        <bpmn:incoming>CKAN_Ocena_calc_F14</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F16</bpmn:outgoing>
        <bpmn:outgoing>CKAN_Ocena_calc_F17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CKAN_Ocena_calc_j3" name="Przyjmij stopień 3">
        <bpmn:incoming>CKAN_Ocena_calc_F7</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_j4" name="Przyjmij stopień 4">
        <bpmn:incoming>CKAN_Ocena_calc_F8</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_j5" name="Przyjmij stopień 5">
        <bpmn:incoming>CKAN_Ocena_calc_F9</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_x3" name="Przyjmij stopień 3">
        <bpmn:incoming>CKAN_Ocena_calc_F11</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_x4" name="Przyjmij stopień 4">
        <bpmn:incoming>CKAN_Ocena_calc_F12</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_x5" name="Przyjmij stopień 5">
        <bpmn:incoming>CKAN_Ocena_calc_F13</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_r4" name="Przyjmij stopień 4">
        <bpmn:incoming>CKAN_Ocena_calc_F15</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_r4b" name="Przyjmij stopień 4">
        <bpmn:incoming>CKAN_Ocena_calc_F16</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CKAN_Ocena_calc_r5" name="Przyjmij stopień 5">
        <bpmn:incoming>CKAN_Ocena_calc_F17</bpmn:incoming>
        <bpmn:outgoing>CKAN_Ocena_calc_F26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CKAN_Ocena_calc_end" name="Wynik pojedynczej oceny">
        <bpmn:incoming>CKAN_Ocena_calc_F18</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F19</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F20</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F21</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F22</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F23</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F24</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F25</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F26</bpmn:incoming>
        <bpmn:incoming>CKAN_Ocena_calc_F27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F1" sourceRef="CKAN_Ocena_calc_start" targetRef="CKAN_Ocena_calc_format" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F2" sourceRef="CKAN_Ocena_calc_format" targetRef="CKAN_Ocena_calc_json" name="JSON">
        <bpmn:conditionExpression>JSON</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F3" sourceRef="CKAN_Ocena_calc_format" targetRef="CKAN_Ocena_calc_xml" name="XML">
        <bpmn:conditionExpression>XML</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F4" sourceRef="CKAN_Ocena_calc_format" targetRef="CKAN_Ocena_calc_rdf" name="RDF i pokrewne">
        <bpmn:conditionExpression>RDF i pokrewne</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F5" sourceRef="CKAN_Ocena_calc_format" targetRef="CKAN_Ocena_calc_default" name="Pozostałe">
        <bpmn:conditionExpression>Pozostałe</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F6" sourceRef="CKAN_Ocena_calc_json" targetRef="CKAN_Ocena_calc_jlinked" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F7" sourceRef="CKAN_Ocena_calc_json" targetRef="CKAN_Ocena_calc_j3" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F8" sourceRef="CKAN_Ocena_calc_jlinked" targetRef="CKAN_Ocena_calc_j4" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F9" sourceRef="CKAN_Ocena_calc_jlinked" targetRef="CKAN_Ocena_calc_j5" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F10" sourceRef="CKAN_Ocena_calc_xml" targetRef="CKAN_Ocena_calc_xlinked" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F11" sourceRef="CKAN_Ocena_calc_xml" targetRef="CKAN_Ocena_calc_x3" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F12" sourceRef="CKAN_Ocena_calc_xlinked" targetRef="CKAN_Ocena_calc_x4" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F13" sourceRef="CKAN_Ocena_calc_xlinked" targetRef="CKAN_Ocena_calc_x5" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F14" sourceRef="CKAN_Ocena_calc_rdf" targetRef="CKAN_Ocena_calc_rlinked" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F15" sourceRef="CKAN_Ocena_calc_rdf" targetRef="CKAN_Ocena_calc_r4" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F16" sourceRef="CKAN_Ocena_calc_rlinked" targetRef="CKAN_Ocena_calc_r4b" name="Nie">
        <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F17" sourceRef="CKAN_Ocena_calc_rlinked" targetRef="CKAN_Ocena_calc_r5" name="Tak">
        <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F18" sourceRef="CKAN_Ocena_calc_j3" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F19" sourceRef="CKAN_Ocena_calc_j4" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F20" sourceRef="CKAN_Ocena_calc_j5" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F21" sourceRef="CKAN_Ocena_calc_x3" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F22" sourceRef="CKAN_Ocena_calc_x4" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F23" sourceRef="CKAN_Ocena_calc_x5" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F24" sourceRef="CKAN_Ocena_calc_r4" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F25" sourceRef="CKAN_Ocena_calc_r4b" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F26" sourceRef="CKAN_Ocena_calc_r5" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:sequenceFlow id="CKAN_Ocena_calc_F27" sourceRef="CKAN_Ocena_calc_default" targetRef="CKAN_Ocena_calc_end" />
      <bpmn:incoming>CKAN_Ocena_F12</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F13</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="CKAN_Ocena_merge" name="Wynik do zapisu" gatewayDirection="Converging">
      <bpmn:incoming>CKAN_Ocena_F4</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F5</bpmn:outgoing>
      <bpmn:incoming>CKAN_Ocena_F13</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CKAN_Ocena_save" name="Zapisz stopień otwartości zasobu">
      <bpmn:documentation>O9: zapis w bazie; dla XML także oceny plików. Następnie data weryfikacji, tylko jeżeli żądana. Zapis oceny nie oznacza jeszcze odświeżenia jej widocznej publikacji.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F5</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CKAN_Ocena_ok" name="Przygotowanie udane i zasób nadal opublikowany?" gatewayDirection="Diverging">
      <bpmn:documentation>URL i wszystkie wymagane kontrole zakończone sukcesem, brak odroczonych wyjątków; zasób opublikowany i nieusunięty. Źródło OALL, PB4.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F6</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F7</bpmn:outgoing>
      <bpmn:outgoing>CKAN_Ocena_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CKAN_Ocena_publish" name="Zleć odświeżenie widocznej oceny">
      <bpmn:documentation>Asynchroniczne odświeżenie dokumentu wyszukiwarki (ES) i opisu katalogowego (RDF). Nie mylić publikacji RDF z testem RDF treści danych przy ocenie.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F7</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CKAN_Ocena_norefresh" name="Pozostaw zapis; obsłuż ewentualny problem">
      <bpmn:documentation>Brak końcowego odświeżenia ES/RDF. Odpowiednio log lub zgłoszenie odroczonego wyjątku. Ocena mogła już zostać zapisana. Nie każdy przypadek tej gałęzi jest błędem: zasób może być nieopublikowany.</bpmn:documentation>
      <bpmn:incoming>CKAN_Ocena_F9</bpmn:incoming>
      <bpmn:outgoing>CKAN_Ocena_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CKAN_Ocena_end" name="Zadanie oceny zakończone">
      <bpmn:incoming>CKAN_Ocena_F8</bpmn:incoming>
      <bpmn:incoming>CKAN_Ocena_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CKAN_Ocena_F1" sourceRef="CKAN_Ocena_start" targetRef="CKAN_Ocena_prep" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F2" sourceRef="CKAN_Ocena_prep" targetRef="CKAN_Ocena_fmt" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F3" sourceRef="CKAN_Ocena_fmt" targetRef="CKAN_Ocena_zero" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CKAN_Ocena_F4" sourceRef="CKAN_Ocena_zero" targetRef="CKAN_Ocena_merge" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F5" sourceRef="CKAN_Ocena_merge" targetRef="CKAN_Ocena_save" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F6" sourceRef="CKAN_Ocena_save" targetRef="CKAN_Ocena_ok" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F7" sourceRef="CKAN_Ocena_ok" targetRef="CKAN_Ocena_publish" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CKAN_Ocena_F8" sourceRef="CKAN_Ocena_publish" targetRef="CKAN_Ocena_end" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F9" sourceRef="CKAN_Ocena_ok" targetRef="CKAN_Ocena_norefresh" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CKAN_Ocena_F10" sourceRef="CKAN_Ocena_norefresh" targetRef="CKAN_Ocena_end" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F11" sourceRef="CKAN_Ocena_fmt" targetRef="CKAN_Ocena_link" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CKAN_Ocena_F12" sourceRef="CKAN_Ocena_link" targetRef="CKAN_Ocena_calc" />
    <bpmn:sequenceFlow id="CKAN_Ocena_F13" sourceRef="CKAN_Ocena_calc" targetRef="CKAN_Ocena_merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="CKAN_Ocena_Diagram" name="CKAN — nadanie stopnia otwartości zasobu">
    <bpmndi:BPMNPlane id="CKAN_Ocena_Plane" bpmnElement="CKAN_Ocena">
      <bpmndi:BPMNShape id="CKAN_Ocena_start_di" bpmnElement="CKAN_Ocena_start">
        <dc:Bounds x="70" y="150" width="46" height="46" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-8" y="204" width="202" height="48" />
        </bpmndi:BPMNLabel>
