    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Ocena_F12" sourceRef="XML_Ocena_main" targetRef="XML_Ocena_files" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Ocena_F13" sourceRef="XML_Ocena_main" targetRef="XML_Ocena_link" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Ocena_F14" sourceRef="XML_Ocena_link" targetRef="XML_Ocena_calc" />
    <bpmn:sequenceFlow id="XML_Ocena_F15" sourceRef="XML_Ocena_calc" targetRef="XML_Ocena_merge" />
    <bpmn:sequenceFlow id="XML_Ocena_F16" sourceRef="XML_Ocena_files" targetRef="XML_Ocena_merge" />
  </bpmn:process>
  <bpmn:process id="XML_Konwersje" name="XML — późniejsze podniesienie stopnia przez pliki pochodne" isExecutable="false">
    <bpmn:documentation>Odwzorowanie AS-IS raportu ../harvester_walidacje_ckan_xml.html (mcod 2.62.3; raport 2026-11-08). Nie potwierdzono bieżącej produkcji. Model biznesowy niewykonywalny. Ocena dotyczy zasobu, nie wyniku importu ani jakości danych.</bpmn:documentation>
    <bpmn:startEvent id="XML_Konwersje_start" name="Odebrano osobne zlecenie po udanej indeksacji danych">
      <bpmn:outgoing>XML_Konwersje_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="XML_Konwersje_csv" name="Główny XLS/XLSX, nie linked, dostępna tabela?" gatewayDirection="Diverging">
      <bpmn:incoming>XML_Konwersje_F1</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F2</bpmn:outgoing>
      <bpmn:outgoing>XML_Konwersje_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="XML_Konwersje_makecsv" name="Utwórz dodatkowy CSV">
      <bpmn:documentation>CSV z danych tabeli, UTF-8, plik pochodny. To nie zmienia pliku głównego.</bpmn:documentation>
      <bpmn:incoming>XML_Konwersje_F2</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="XML_Konwersje_merge" name="Przejdź do próby JSON-LD" gatewayDirection="Converging">
      <bpmn:incoming>XML_Konwersje_F3</bpmn:incoming>
      <bpmn:incoming>XML_Konwersje_F4</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="XML_Konwersje_json" name="Dostępny CSV poza archiwum?" gatewayDirection="Diverging">
      <bpmn:incoming>XML_Konwersje_F5</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F6</bpmn:outgoing>
      <bpmn:outgoing>XML_Konwersje_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="XML_Konwersje_makejson" name="Spróbuj utworzyć dodatkowy JSON-LD">
      <bpmn:documentation>CSV główny albo pochodny. Błąd konwersji jest logowany i nie daje nowego pliku. Powodzenia tej konwersji nie potwierdzono w teście B. Próba może dotyczyć XML remote: SCEN-10, SECTION-pliki-7; rozbieżność V-03 w README.</bpmn:documentation>
      <bpmn:incoming>XML_Konwersje_F6</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="XML_Konwersje_created" name="Powstał nowy plik pochodny?" gatewayDirection="Diverging">
      <bpmn:incoming>XML_Konwersje_F7</bpmn:incoming>
      <bpmn:incoming>XML_Konwersje_F8</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F9</bpmn:outgoing>
      <bpmn:outgoing>XML_Konwersje_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="XML_Konwersje_score" name="Ponownie oceń pliki i zapisz ich maksimum">
      <bpmn:documentation>Te same reguły co w diagramie głównym XML i jego podprocesach. XLSX 2 → z CSV maks. 3 → z JSON-LD maks. 4–5, o ile konwersje się powiodą.</bpmn:documentation>
      <bpmn:incoming>XML_Konwersje_F9</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="XML_Konwersje_publish" name="Zleć odświeżenie publikacji z nową oceną">
      <bpmn:documentation>update_es_and_rdf_db: warunki publikacji/nieusunięcia nadal obowiązują. Zlecenia ES/RDF są asynchroniczne.</bpmn:documentation>
      <bpmn:incoming>XML_Konwersje_F11</bpmn:incoming>
      <bpmn:outgoing>XML_Konwersje_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="XML_Konwersje_end" name="Koniec próby podniesienia stopnia">
      <bpmn:incoming>XML_Konwersje_F10</bpmn:incoming>
      <bpmn:incoming>XML_Konwersje_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="XML_Konwersje_F1" sourceRef="XML_Konwersje_start" targetRef="XML_Konwersje_csv" />
    <bpmn:sequenceFlow id="XML_Konwersje_F2" sourceRef="XML_Konwersje_csv" targetRef="XML_Konwersje_makecsv" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F3" sourceRef="XML_Konwersje_makecsv" targetRef="XML_Konwersje_merge" />
    <bpmn:sequenceFlow id="XML_Konwersje_F4" sourceRef="XML_Konwersje_csv" targetRef="XML_Konwersje_merge" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F5" sourceRef="XML_Konwersje_merge" targetRef="XML_Konwersje_json" />
    <bpmn:sequenceFlow id="XML_Konwersje_F6" sourceRef="XML_Konwersje_json" targetRef="XML_Konwersje_makejson" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F7" sourceRef="XML_Konwersje_makejson" targetRef="XML_Konwersje_created" />
    <bpmn:sequenceFlow id="XML_Konwersje_F8" sourceRef="XML_Konwersje_json" targetRef="XML_Konwersje_created" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F9" sourceRef="XML_Konwersje_created" targetRef="XML_Konwersje_score" name="Tak">
      <bpmn:conditionExpression>Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F10" sourceRef="XML_Konwersje_created" targetRef="XML_Konwersje_end" name="Nie">
      <bpmn:conditionExpression>Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="XML_Konwersje_F11" sourceRef="XML_Konwersje_score" targetRef="XML_Konwersje_publish" />
    <bpmn:sequenceFlow id="XML_Konwersje_F12" sourceRef="XML_Konwersje_publish" targetRef="XML_Konwersje_end" />
  </bpmn:process>
