<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns5="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="VP172_manual_Definitions" targetNamespace="urn:mcod:vp172:manual" exporter="Lokalny model mcod AS-IS — BPMN 2.0 XML" exporterVersion="2026-11-19">
  <bpmn:collaboration id="VIEW_manual_coll" name="3. Ręczne dodanie — plik lub URL, ocena i konwersje">
    <bpmn:documentation>Plik wymiany BPMN 2.0 do importu w Visual Paradigm 17.2 przez Project &gt; Import &gt; BPMN 2.0. Zawiera uzupełniony widok główny oraz szczegółowe procesy i podprocesy. AS-IS mcod 2.62.3; bez projektowanych blokad. Nie jest natywnym plikiem projektu VPP i nie zawiera wymyślonych rozszerzeń producenta. Import w konkretnej instalacji 17.2 wymaga sprawdzenia.</bpmn:documentation>
    <bpmn:participant id="manual_form_pool" name="PANEL ADMINISTRACYJNY — formularz i zapis" processRef="manual_form" />
    <bpmn:participant id="manual_dispatch_pool" name="ZAPIS ZASOBU — decyzja o przygotowaniu; zlecenie po zatwierdzeniu transakcji" processRef="manual_dispatch" />
    <bpmn:participant id="manual_prep_url_pool" name="PRZYGOTOWANIE W TLE — URL zasobu" processRef="manual_prep_url" />
    <bpmn:participant id="manual_prep_upload_pool" name="PRZYGOTOWANIE W TLE — plik z dysku" processRef="manual_prep_upload" />
    <bpmn:participant id="manual_conversion_pool" name="PLIKI POCHODNE W TLE — wspólny algorytm XML i ręcznego dodania" processRef="manual_conversion" />
    <bpmn:participant id="manual_archive_pool" name="PACZKA PLIKÓW ZBIORU — niezależne zadanie" processRef="manual_archive" />
    <bpmn:participant id="manual_publication_pool" name="PUBLIKACJA W TLE — osobne zadania zależne od zdarzenia zapisu / oceny" processRef="manual_publication" />
    <bpmn:messageFlow id="manual_flow_128" sourceRef="manual_save" targetRef="manual_dispatchstart" />
    <bpmn:messageFlow id="manual_flow_387" sourceRef="manual_prepsend" targetRef="manual_url_start" name="URL" />
    <bpmn:messageFlow id="manual_flow_591" sourceRef="manual_uploadsend" targetRef="manual_upload_start" name="Upload" />
    <bpmn:messageFlow id="manual_flow_746" sourceRef="manual_url_derive" targetRef="manual_convstart" />
    <bpmn:messageFlow id="manual_flow_754" sourceRef="manual_upload_derive" targetRef="manual_convstart" />
    <bpmn:messageFlow id="manual_flow_825" sourceRef="manual_archsend" targetRef="manual_archstart" />
    <bpmn:messageFlow id="manual_flow_863" sourceRef="manual_save" targetRef="manual_pubstart" name="Według zdarzenia zapisu" />
    <bpmn:messageFlow id="manual_flow_871" sourceRef="manual_url_refresh" targetRef="manual_pubstart" name="ES/RDF" />
    <bpmn:messageFlow id="manual_flow_879" sourceRef="manual_upload_refresh" targetRef="manual_pubstart" name="ES/RDF" />
    <bpmn:messageFlow id="manual_flow_887" sourceRef="manual_convrefresh" targetRef="manual_pubstart" name="ES/RDF" />
  </bpmn:collaboration>
  <bpmn:process id="manual_form" isExecutable="false" name="PANEL ADMINISTRACYJNY — formularz i zapis">
    <bpmn:startEvent id="manual_formstart" name="Dodawanie zasobu">
      <bpmn:outgoing>manual_flow_38</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="manual_form_input" name="Wskaż plik z dysku lub URL; uzupełnij opis i status">
      <bpmn:incoming>manual_flow_38</bpmn:incoming>
      <bpmn:incoming>manual_flow_70</bpmn:incoming>
      <bpmn:outgoing>manual_flow_46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="manual_formvalidation" name="Sprawdź formularz i szczególne wymagania">
      <bpmn:incoming>manual_flow_46</bpmn:incoming>
      <bpmn:outgoing>manual_flow_52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_formok" name="Formularz poprawny?">
      <bpmn:incoming>manual_flow_52</bpmn:incoming>
      <bpmn:outgoing>manual_flow_60</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_80</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="manual_fix" name="Pokaż błędy; popraw formularz">
      <bpmn:incoming>manual_flow_60</bpmn:incoming>
      <bpmn:outgoing>manual_flow_70</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="manual_save" name="Zapisz zasób; dla uploadu zapisz plik główny">
      <bpmn:incoming>manual_flow_80</bpmn:incoming>
      <bpmn:outgoing>manual_flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="manual_formend" name="Zapis zakończony; praca w tle może trwać">
      <bpmn:incoming>manual_flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="manual_flow_30" sourceRef="manual_save" targetRef="manual_formend" />
    <bpmn:sequenceFlow id="manual_flow_38" sourceRef="manual_formstart" targetRef="manual_form_input" />
    <bpmn:sequenceFlow id="manual_flow_46" sourceRef="manual_form_input" targetRef="manual_formvalidation" />
    <bpmn:sequenceFlow id="manual_flow_52" sourceRef="manual_formvalidation" targetRef="manual_formok" />
    <bpmn:sequenceFlow id="manual_flow_60" sourceRef="manual_formok" targetRef="manual_fix" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_70" sourceRef="manual_fix" targetRef="manual_form_input" />
    <bpmn:sequenceFlow id="manual_flow_80" sourceRef="manual_formok" targetRef="manual_save" name="Tak" />
  </bpmn:process>
  <bpmn:process id="manual_dispatch" isExecutable="false" name="ZAPIS ZASOBU — decyzja o przygotowaniu; zlecenie po zatwierdzeniu transakcji">
    <bpmn:startEvent id="manual_dispatchstart" name="Obsługa zapisu / sygnału zasobu">
      <bpmn:outgoing>manual_flow_104</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="manual_condition" name="Stan i zmiana wymagają przygotowania?">
      <bpmn:documentation>Zapis nie oznacza zawsze nowej oceny. Nowy opublikowany zasób / zmiana linku lub dostępności / właściwa zmiana wymuszonego typu / przywrócenie; nowy główny plik opublikowanego zasobu ma osobny sygnał. Sam opis lub format nie gwarantuje oceny. Zmiana znaków umownych ma odrębną ścieżkę. Szczegółowe warunki w modelu szczegółowym.</bpmn:documentation>
      <bpmn:incoming>manual_flow_104</bpmn:incoming>
      <bpmn:outgoing>manual_flow_112</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_142</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_prepsend" name="Zleć przygotowanie URL">
      <bpmn:incoming>manual_flow_148</bpmn:incoming>
      <bpmn:outgoing>manual_flow_120</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="manual_dispatchend" name="Koniec obsługi zapisu">
      <bpmn:incoming>manual_flow_112</bpmn:incoming>
      <bpmn:incoming>manual_flow_120</bpmn:incoming>
      <bpmn:incoming>manual_flow_164</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="manual_flow_104" sourceRef="manual_dispatchstart" targetRef="manual_condition" />
    <bpmn:sequenceFlow id="manual_flow_112" sourceRef="manual_condition" targetRef="manual_dispatchend" name="Nie — m.in. nowy szkic" />
    <bpmn:sequenceFlow id="manual_flow_120" sourceRef="manual_prepsend" targetRef="manual_dispatchend" />
    <bpmn:exclusiveGateway id="manual_inputchoice" name="Nowy plik główny czy zewnętrzny URL?">
      <bpmn:incoming>manual_flow_142</bpmn:incoming>
      <bpmn:outgoing>manual_flow_148</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_156</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_uploadsend" name="Zleć kontrolę zapisanego pliku głównego">
      <bpmn:incoming>manual_flow_156</bpmn:incoming>
      <bpmn:outgoing>manual_flow_164</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="manual_flow_142" sourceRef="manual_condition" targetRef="manual_inputchoice" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_148" sourceRef="manual_inputchoice" targetRef="manual_prepsend" name="URL" />
    <bpmn:sequenceFlow id="manual_flow_156" sourceRef="manual_inputchoice" targetRef="manual_uploadsend" name="Plik" />
    <bpmn:sequenceFlow id="manual_flow_164" sourceRef="manual_uploadsend" targetRef="manual_dispatchend" />
  </bpmn:process>
  <bpmn:process id="manual_prep_url" isExecutable="false" name="PRZYGOTOWANIE W TLE — URL zasobu">
    <bpmn:startEvent id="manual_url_start" name="Odebrano zlecenie">
      <bpmn:outgoing>manual_flow_225</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="manual_url_src" name="Sprawdź URL i rozpoznaj typ; dla pliku zapisz kopię główną">
      <bpmn:incoming>manual_flow_225</bpmn:incoming>
      <bpmn:outgoing>manual_flow_233</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_url_need" name="Można i trzeba kontrolować plik?">
      <bpmn:incoming>manual_flow_233</bpmn:incoming>
      <bpmn:outgoing>manual_flow_241</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_249</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_url_file" name="Sprawdź plik: format, MIME, kodowanie i archiwum">
      <bpmn:incoming>manual_flow_241</bpmn:incoming>
      <bpmn:outgoing>manual_flow_257</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_url_fileok" name="Kontrola pliku udana?">
      <bpmn:incoming>manual_flow_257</bpmn:incoming>
      <bpmn:outgoing>manual_flow_265</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_271</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="manual_url_eligible" name="Dane kwalifikują się do tabeli?">
      <bpmn:documentation>Plik główny; format zasobu lub wnętrza CSV/TSV/XLS/XLSX/ODS/SHP; instytucja inna niż developer. Bez kwalifikacji pomija się dane tabeli, nie samą ocenę. success może współistnieć z failed; nie oznacza poprawności każdego wiersza.</bpmn:documentation>
      <bpmn:incoming>manual_flow_265</bpmn:incoming>
      <bpmn:outgoing>manual_flow_279</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_287</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_url_data" name="Ustal schemat, sprawdź i zindeksuj dane">
      <bpmn:incoming>manual_flow_279</bpmn:incoming>
      <bpmn:outgoing>manual_flow_295</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_url_indexed" name="Wynik indeksacji success dodatni?">
      <bpmn:incoming>manual_flow_295</bpmn:incoming>
      <bpmn:outgoing>manual_flow_303</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_311</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_url_derive" name="Zleć pliki pochodne po zatwierdzeniu indeksacji">
      <bpmn:incoming>manual_flow_303</bpmn:incoming>
      <bpmn:outgoing>manual_flow_319</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="manual_url_score" name="Oblicz i zapisz stopień: pliki albo link">
      <bpmn:documentation>Brak wartości formatu całego zasobu: 0. Brak pliku głównego i istniejący link: ocena linku. W przeciwnym razie maksimum ocen pliku głównego i pochodnych. Błąd obliczenia może przerwać zadanie przed nowym zapisem. Reguły archiwów i formatów są rozwinięte w szczegółach. Ocena nie stanowi blokady publikacji w obecnym kodzie.</bpmn:documentation>
      <bpmn:incoming>manual_flow_249</bpmn:incoming>
      <bpmn:incoming>manual_flow_271</bpmn:incoming>
      <bpmn:incoming>manual_flow_287</bpmn:incoming>
      <bpmn:incoming>manual_flow_311</bpmn:incoming>
      <bpmn:incoming>manual_flow_319</bpmn:incoming>
      <bpmn:outgoing>manual_flow_325</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="manual_url_date" name="Zapisz datę weryfikacji, jeżeli żądana">
      <bpmn:incoming>manual_flow_325</bpmn:incoming>
      <bpmn:outgoing>manual_flow_331</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_url_ok" name="Wymagane etapy udane, bez odroczonych wyjątków?">
      <bpmn:incoming>manual_flow_331</bpmn:incoming>
      <bpmn:outgoing>manual_flow_339</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_345</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="manual_url_pub" name="Nadal opublikowany i nieusunięty?">
      <bpmn:incoming>manual_flow_339</bpmn:incoming>
      <bpmn:outgoing>manual_flow_353</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_361</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_url_refresh" name="Zleć odświeżenie ES/RDF">
      <bpmn:incoming>manual_flow_353</bpmn:incoming>
      <bpmn:outgoing>manual_flow_369</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="manual_url_end" name="Koniec zadania">
      <bpmn:incoming>manual_flow_361</bpmn:incoming>
      <bpmn:incoming>manual_flow_369</bpmn:incoming>
      <bpmn:incoming>manual_flow_377</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="manual_url_problem" name="Zaloguj / zgłoś problem; bez końcowego odświeżenia">
      <bpmn:incoming>manual_flow_345</bpmn:incoming>
      <bpmn:outgoing>manual_flow_377</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="manual_flow_225" sourceRef="manual_url_start" targetRef="manual_url_src" />
    <bpmn:sequenceFlow id="manual_flow_233" sourceRef="manual_url_src" targetRef="manual_url_need" />
    <bpmn:sequenceFlow id="manual_flow_241" sourceRef="manual_url_need" targetRef="manual_url_file" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_249" sourceRef="manual_url_need" targetRef="manual_url_score" name="Nie / brak pliku" />
    <bpmn:sequenceFlow id="manual_flow_257" sourceRef="manual_url_file" targetRef="manual_url_fileok" />
    <bpmn:sequenceFlow id="manual_flow_265" sourceRef="manual_url_fileok" targetRef="manual_url_eligible" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_271" sourceRef="manual_url_fileok" targetRef="manual_url_score" name="Nie — ocena dostępnego stanu" />
    <bpmn:sequenceFlow id="manual_flow_279" sourceRef="manual_url_eligible" targetRef="manual_url_data" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_287" sourceRef="manual_url_eligible" targetRef="manual_url_score" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_295" sourceRef="manual_url_data" targetRef="manual_url_indexed" />
    <bpmn:sequenceFlow id="manual_flow_303" sourceRef="manual_url_indexed" targetRef="manual_url_derive" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_311" sourceRef="manual_url_indexed" targetRef="manual_url_score" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_319" sourceRef="manual_url_derive" targetRef="manual_url_score" />
    <bpmn:sequenceFlow id="manual_flow_325" sourceRef="manual_url_score" targetRef="manual_url_date" />
    <bpmn:sequenceFlow id="manual_flow_331" sourceRef="manual_url_date" targetRef="manual_url_ok" />
    <bpmn:sequenceFlow id="manual_flow_339" sourceRef="manual_url_ok" targetRef="manual_url_pub" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_345" sourceRef="manual_url_ok" targetRef="manual_url_problem" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_353" sourceRef="manual_url_pub" targetRef="manual_url_refresh" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_361" sourceRef="manual_url_pub" targetRef="manual_url_end" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_369" sourceRef="manual_url_refresh" targetRef="manual_url_end" />
    <bpmn:sequenceFlow id="manual_flow_377" sourceRef="manual_url_problem" targetRef="manual_url_end" />
  </bpmn:process>
  <bpmn:process id="manual_prep_upload" isExecutable="false" name="PRZYGOTOWANIE W TLE — plik z dysku">
    <bpmn:startEvent id="manual_upload_start" name="Odebrano zlecenie">
      <bpmn:outgoing>manual_flow_444</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="manual_upload_src" name="Wczytaj zapisany plik główny">
      <bpmn:documentation>Entrypoint pliku najpierw ładuje ResourceFile i nieusunięty Resource; brak rekordu może przerwać zadanie. Po kontroli danych, przy update_link, udanej kontroli pliku i braku odroczonych błędów zapisuje wynik linku SUCCESS bez pobierania HTTP, a potem oblicza ocenę. Szczegóły w entrypoint_res_file.py.</bpmn:documentation>
      <bpmn:incoming>manual_flow_444</bpmn:incoming>
      <bpmn:outgoing>manual_flow_452</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="manual_upload_file" name="Sprawdź plik: format, MIME, kodowanie i archiwum">
      <bpmn:incoming>manual_flow_452</bpmn:incoming>
      <bpmn:outgoing>manual_flow_460</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_upload_fileok" name="Kontrola pliku udana?">
      <bpmn:incoming>manual_flow_460</bpmn:incoming>
      <bpmn:outgoing>manual_flow_468</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_474</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="manual_upload_eligible" name="Dane kwalifikują się do tabeli?">
      <bpmn:documentation>Plik główny; format zasobu lub wnętrza CSV/TSV/XLS/XLSX/ODS/SHP; instytucja inna niż developer. Bez kwalifikacji pomija się dane tabeli, nie samą ocenę. success może współistnieć z failed; nie oznacza poprawności każdego wiersza.</bpmn:documentation>
      <bpmn:incoming>manual_flow_468</bpmn:incoming>
      <bpmn:outgoing>manual_flow_482</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_490</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_upload_data" name="Ustal schemat, sprawdź i zindeksuj dane">
      <bpmn:incoming>manual_flow_482</bpmn:incoming>
      <bpmn:outgoing>manual_flow_498</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_upload_indexed" name="Wynik indeksacji success dodatni?">
      <bpmn:incoming>manual_flow_498</bpmn:incoming>
      <bpmn:outgoing>manual_flow_506</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_514</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_upload_derive" name="Zleć pliki pochodne po zatwierdzeniu indeksacji">
      <bpmn:incoming>manual_flow_506</bpmn:incoming>
      <bpmn:outgoing>manual_flow_522</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="manual_upload_score" name="Oblicz i zapisz stopień: pliki albo link">
      <bpmn:documentation>Brak wartości formatu całego zasobu: 0. Brak pliku głównego i istniejący link: ocena linku. W przeciwnym razie maksimum ocen pliku głównego i pochodnych. Błąd obliczenia może przerwać zadanie przed nowym zapisem. Reguły archiwów i formatów są rozwinięte w szczegółach. Ocena nie stanowi blokady publikacji w obecnym kodzie.</bpmn:documentation>
      <bpmn:incoming>manual_flow_474</bpmn:incoming>
      <bpmn:incoming>manual_flow_490</bpmn:incoming>
      <bpmn:incoming>manual_flow_514</bpmn:incoming>
      <bpmn:incoming>manual_flow_522</bpmn:incoming>
      <bpmn:outgoing>manual_flow_528</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="manual_upload_date" name="Zapisz datę weryfikacji, jeżeli żądana">
      <bpmn:incoming>manual_flow_528</bpmn:incoming>
      <bpmn:outgoing>manual_flow_534</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_upload_ok" name="Wymagane etapy udane, bez odroczonych wyjątków?">
      <bpmn:incoming>manual_flow_534</bpmn:incoming>
      <bpmn:outgoing>manual_flow_542</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_548</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="manual_upload_pub" name="Nadal opublikowany i nieusunięty?">
      <bpmn:incoming>manual_flow_542</bpmn:incoming>
      <bpmn:outgoing>manual_flow_556</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_564</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_upload_refresh" name="Zleć odświeżenie ES/RDF">
      <bpmn:incoming>manual_flow_556</bpmn:incoming>
      <bpmn:outgoing>manual_flow_572</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="manual_upload_end" name="Koniec zadania">
      <bpmn:incoming>manual_flow_564</bpmn:incoming>
      <bpmn:incoming>manual_flow_572</bpmn:incoming>
      <bpmn:incoming>manual_flow_580</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="manual_upload_problem" name="Zaloguj / zgłoś problem; bez końcowego odświeżenia">
      <bpmn:incoming>manual_flow_548</bpmn:incoming>
      <bpmn:outgoing>manual_flow_580</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="manual_flow_444" sourceRef="manual_upload_start" targetRef="manual_upload_src" />
    <bpmn:sequenceFlow id="manual_flow_452" sourceRef="manual_upload_src" targetRef="manual_upload_file" />
    <bpmn:sequenceFlow id="manual_flow_460" sourceRef="manual_upload_file" targetRef="manual_upload_fileok" />
    <bpmn:sequenceFlow id="manual_flow_468" sourceRef="manual_upload_fileok" targetRef="manual_upload_eligible" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_474" sourceRef="manual_upload_fileok" targetRef="manual_upload_score" name="Nie — ocena dostępnego stanu" />
    <bpmn:sequenceFlow id="manual_flow_482" sourceRef="manual_upload_eligible" targetRef="manual_upload_data" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_490" sourceRef="manual_upload_eligible" targetRef="manual_upload_score" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_498" sourceRef="manual_upload_data" targetRef="manual_upload_indexed" />
    <bpmn:sequenceFlow id="manual_flow_506" sourceRef="manual_upload_indexed" targetRef="manual_upload_derive" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_514" sourceRef="manual_upload_indexed" targetRef="manual_upload_score" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_522" sourceRef="manual_upload_derive" targetRef="manual_upload_score" />
    <bpmn:sequenceFlow id="manual_flow_528" sourceRef="manual_upload_score" targetRef="manual_upload_date" />
    <bpmn:sequenceFlow id="manual_flow_534" sourceRef="manual_upload_date" targetRef="manual_upload_ok" />
    <bpmn:sequenceFlow id="manual_flow_542" sourceRef="manual_upload_ok" targetRef="manual_upload_pub" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_548" sourceRef="manual_upload_ok" targetRef="manual_upload_problem" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_556" sourceRef="manual_upload_pub" targetRef="manual_upload_refresh" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_564" sourceRef="manual_upload_pub" targetRef="manual_upload_end" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_572" sourceRef="manual_upload_refresh" targetRef="manual_upload_end" />
    <bpmn:sequenceFlow id="manual_flow_580" sourceRef="manual_upload_problem" targetRef="manual_upload_end" />
  </bpmn:process>
  <bpmn:process id="manual_conversion" isExecutable="false" name="PLIKI POCHODNE W TLE — wspólny algorytm XML i ręcznego dodania">
    <bpmn:startEvent id="manual_convstart" name="Odebrano zlecenie konwersji">
      <bpmn:outgoing>manual_flow_636</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="manual_xls" name="XLS/XLSX, nie linked, są dane i tabela?">
      <bpmn:documentation>XML: linked to availability=remote; ręczne: linked to zewnętrzny URL. Konwersja do CSV uwzględnia format zasobu lub wnętrza archiwum. Brak linked nie jest warunkiem próby JSON-LD z dostępnego CSV. Pierwsza ocena nie czeka na to zadanie.</bpmn:documentation>
      <bpmn:incoming>manual_flow_636</bpmn:incoming>
      <bpmn:outgoing>manual_flow_644</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_652</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_csv" name="Utwórz lub odtwórz pochodny CSV UTF-8">
      <bpmn:incoming>manual_flow_644</bpmn:incoming>
      <bpmn:outgoing>manual_flow_660</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_csvavailable" name="Dostępny CSV do konwersji, poza archiwum?">
      <bpmn:incoming>manual_flow_652</bpmn:incoming>
      <bpmn:incoming>manual_flow_660</bpmn:incoming>
      <bpmn:outgoing>manual_flow_668</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_676</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_jsonld" name="Spróbuj utworzyć / odtworzyć JSON-LD">
      <bpmn:incoming>manual_flow_668</bpmn:incoming>
      <bpmn:outgoing>manual_flow_684</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="manual_archsend" name="Zleć paczkę plików zbioru z opóźnieniem">
      <bpmn:documentation>Kod zleca dataset.archive_files po powrocie increase_openness_score, przed warunkowym przeliczeniem oceny; także gdy nie powstał plik. Nieprzechwycony wyjątek wcześniej przerywa tę ścieżkę. Paczka plików to nie projektowana flaga archiwum.</bpmn:documentation>
      <bpmn:incoming>manual_flow_676</bpmn:incoming>
      <bpmn:incoming>manual_flow_684</bpmn:incoming>
      <bpmn:outgoing>manual_flow_690</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="manual_created" name="Powstał / odtworzono plik pochodny?">
      <bpmn:incoming>manual_flow_690</bpmn:incoming>
      <bpmn:outgoing>manual_flow_698</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_706</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_rescore" name="Ponownie oblicz i zapisz ocenę wszystkich plików">
      <bpmn:incoming>manual_flow_698</bpmn:incoming>
      <bpmn:outgoing>manual_flow_714</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="manual_convpub" name="Nadal opublikowany i nieusunięty?">
      <bpmn:incoming>manual_flow_714</bpmn:incoming>
      <bpmn:outgoing>manual_flow_722</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_730</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="manual_convrefresh" name="Zleć odświeżenie ES/RDF z nową oceną">
      <bpmn:incoming>manual_flow_722</bpmn:incoming>
      <bpmn:outgoing>manual_flow_738</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="manual_convend" name="Koniec konwersji">
      <bpmn:incoming>manual_flow_706</bpmn:incoming>
      <bpmn:incoming>manual_flow_730</bpmn:incoming>
      <bpmn:incoming>manual_flow_738</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="manual_flow_636" sourceRef="manual_convstart" targetRef="manual_xls" />
    <bpmn:sequenceFlow id="manual_flow_644" sourceRef="manual_xls" targetRef="manual_csv" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_652" sourceRef="manual_xls" targetRef="manual_csvavailable" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_660" sourceRef="manual_csv" targetRef="manual_csvavailable" />
    <bpmn:sequenceFlow id="manual_flow_668" sourceRef="manual_csvavailable" targetRef="manual_jsonld" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_676" sourceRef="manual_csvavailable" targetRef="manual_archsend" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_684" sourceRef="manual_jsonld" targetRef="manual_archsend" />
    <bpmn:sequenceFlow id="manual_flow_690" sourceRef="manual_archsend" targetRef="manual_created" />
    <bpmn:sequenceFlow id="manual_flow_698" sourceRef="manual_created" targetRef="manual_rescore" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_706" sourceRef="manual_created" targetRef="manual_convend" name="Nie — bez ponownej oceny" />
    <bpmn:sequenceFlow id="manual_flow_714" sourceRef="manual_rescore" targetRef="manual_convpub" />
    <bpmn:sequenceFlow id="manual_flow_722" sourceRef="manual_convpub" targetRef="manual_convrefresh" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_730" sourceRef="manual_convpub" targetRef="manual_convend" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_738" sourceRef="manual_convrefresh" targetRef="manual_convend" />
  </bpmn:process>
  <bpmn:process id="manual_archive" isExecutable="false" name="PACZKA PLIKÓW ZBIORU — niezależne zadanie">
    <bpmn:startEvent id="manual_archstart" name="Odebrano zlecenie po opóźnieniu">
      <bpmn:outgoing>manual_flow_783</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="manual_disk" name="Wystarczające wolne miejsce?">
      <bpmn:incoming>manual_flow_783</bpmn:incoming>
      <bpmn:outgoing>manual_flow_791</bpmn:outgoing>
      <bpmn:outgoing>manual_flow_799</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="manual_build" name="Przygotuj ZIP plików zbioru i zaktualizuj odnośnik">
      <bpmn:incoming>manual_flow_791</bpmn:incoming>
      <bpmn:outgoing>manual_flow_817</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="manual_archend" name="Koniec zadania paczki">
      <bpmn:incoming>manual_flow_809</bpmn:incoming>
      <bpmn:incoming>manual_flow_817</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="manual_nospace" name="Zaloguj brak miejsca; pomiń budowę">
      <bpmn:incoming>manual_flow_799</bpmn:incoming>
      <bpmn:outgoing>manual_flow_809</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="manual_flow_783" sourceRef="manual_archstart" targetRef="manual_disk" />
    <bpmn:sequenceFlow id="manual_flow_791" sourceRef="manual_disk" targetRef="manual_build" name="Tak" />
    <bpmn:sequenceFlow id="manual_flow_799" sourceRef="manual_disk" targetRef="manual_nospace" name="Nie" />
    <bpmn:sequenceFlow id="manual_flow_809" sourceRef="manual_nospace" targetRef="manual_archend" />
    <bpmn:sequenceFlow id="manual_flow_817" sourceRef="manual_build" targetRef="manual_archend" />
  </bpmn:process>
  <bpmn:process id="manual_publication" isExecutable="false" name="PUBLIKACJA W TLE — osobne zadania zależne od zdarzenia zapisu / oceny">
    <bpmn:startEvent id="manual_pubstart" name="Odebrano odpowiednie zlecenie">
      <bpmn:outgoing>manual_flow_846</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="manual_pubtasks" name="Wykonaj zlecone aktualizacje ES/API, RDF i powiadomień">
      <bpmn:documentation>To agregacja niezależnych zadań, a nie ich kolejność. Zapis/zmiana stanu może zlecić publikację przed ukończeniem przygotowania. Końcowe odświeżenie po ocenie zleca ES/RDF, nie automatycznie każdy rodzaj powiadomienia. Szczegóły mapy sygnałów i odbiorców w modelach szczegółowych.</bpmn:documentation>
      <bpmn:incoming>manual_flow_846</bpmn:incoming>
      <bpmn:outgoing>manual_flow_854</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="manual_pubend" name="Koniec danego zadania publikacji">
      <bpmn:incoming>manual_flow_854</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="manual_flow_846" sourceRef="manual_pubstart" targetRef="manual_pubtasks" />
    <bpmn:sequenceFlow id="manual_flow_854" sourceRef="manual_pubtasks" targetRef="manual_pubend" />
  </bpmn:process>
  <bpmn:process id="RECZNE_Formularz" name="1. Edytor — zdefiniowanie i zapis zasobu" isExecutable="false">
    <bpmn:documentation>Model biznesowy ręcznego dodania zasobu w panelu administracyjnym. Podstawa: lokalny snapshot mcod/backend/2.62.3/98b9855d7b47cb8fd8680ab70c6114f138ac46123ea1541fbce2664866f09578-tree; resources/forms.py, admin.py, models.py i tasks. Analiza statyczna, bez uruchamiania aplikacji. Diagram agreguje dwie ścieżki wejścia w pojedynczy krok zgodnie z prośbą użytkownika. Zapis jako szkic nie uruchamia tego samego przebiegu co zapis opublikowanego zasobu.</bpmn:documentation>
    <bpmn:startEvent id="RECZNE_Formularz_start" name="Rozpoczęcie dodawania zasobu">
      <bpmn:outgoing>RECZNE_Formularz_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="RECZNE_Formularz_source" name="Wskaż plik z dysku lub URL">
      <bpmn:documentation>AddResourceForm / LinkOrFileUploadForm: jedno wejście biznesowe, dwie ścieżki techniczne. Brak bramki wyboru źródła na diagramie zgodnie z wymaganiem.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F1</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RECZNE_Formularz_fields" name="Uzupełnij pozostałe pola i status zasobu">
      <bpmn:documentation>M.in. zbiór, tytuł, opis, data danych i status. Szczegółowe wymagania zależą od rodzaju zasobu i uprawnień.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F2</bpmn:incoming>
      <bpmn:incoming>RECZNE_Formularz_F8</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RECZNE_Formularz_click" name="Kliknij „Zapisz”">
      <bpmn:incoming>RECZNE_Formularz_F3</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="RECZNE_Formularz_validate" name="Sprawdź formularz i reguły pól">
      <bpmn:documentation>AddResourceForm.clean_link: HTTPS; clean_file: obsługiwane rozszerzenie i brak szyfrowanego archiwum. ResourceForm.clean i walidacja modelu: pozostałe reguły, m.in. flagi DGA/HVD. To nie jest jeszcze pełna kontrola pobranych danych.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F4</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Formularz_ok" name="Formularz poprawny?" gatewayDirection="Diverging">
      <bpmn:incoming>RECZNE_Formularz_F5</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F6</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Formularz_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RECZNE_Formularz_error" name="Pokaż błędy; popraw dane">
      <bpmn:documentation>Błędy blokują zapis nowego zasobu; edytor poprawia dane i ponownie zapisuje formularz.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F7</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RECZNE_Formularz_save" name="Zapisz zasób i wskazany plik lub URL">
      <bpmn:documentation>ResourceAdmin.save_model: obj.save(); plik z dysku → ResourceFile.objects.update_or_create(..., is_main=True). Dla nowego URL sygnał process_resource; dla utworzonego pliku głównego process_created_file.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F6</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Formularz_status" name="Zasób jest opublikowany?" gatewayDirection="Diverging">
      <bpmn:documentation>Zakres: utworzenie nowego zasobu. Dla nowego szkicu brak zlecenia przetwarzania; pierwsza publikacja szkicu może je uruchomić później.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F9</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F10</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Formularz_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="RECZNE_Formularz_send" name="Zleć przygotowanie zasobu po zatwierdzeniu zapisu">
      <bpmn:documentation>Plik z dysku: process_created_file → entrypoint_process_resource_file_validation_task. URL: process_resource → entrypoint_process_resource_validation_task. Oba apply_async_on_commit. Przyjęto zwykłe dodanie jednego źródła plik ALBO URL.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Formularz_F10</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Formularz_F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="RECZNE_Formularz_end" name="Zapis zakończony; praca w tle">
      <bpmn:incoming>RECZNE_Formularz_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="RECZNE_Formularz_draft" name="Zapisano szkic; bez tego przetwarzania">
      <bpmn:incoming>RECZNE_Formularz_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="RECZNE_Formularz_F1" sourceRef="RECZNE_Formularz_start" targetRef="RECZNE_Formularz_source" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F2" sourceRef="RECZNE_Formularz_source" targetRef="RECZNE_Formularz_fields" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F3" sourceRef="RECZNE_Formularz_fields" targetRef="RECZNE_Formularz_click" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F4" sourceRef="RECZNE_Formularz_click" targetRef="RECZNE_Formularz_validate" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F5" sourceRef="RECZNE_Formularz_validate" targetRef="RECZNE_Formularz_ok" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F6" sourceRef="RECZNE_Formularz_ok" targetRef="RECZNE_Formularz_save" name="Tak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="RECZNE_Formularz_F7" sourceRef="RECZNE_Formularz_ok" targetRef="RECZNE_Formularz_error" name="Nie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="RECZNE_Formularz_F8" sourceRef="RECZNE_Formularz_error" targetRef="RECZNE_Formularz_fields" name="Popraw i zapisz" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F9" sourceRef="RECZNE_Formularz_save" targetRef="RECZNE_Formularz_status" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F10" sourceRef="RECZNE_Formularz_status" targetRef="RECZNE_Formularz_send" name="Tak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="RECZNE_Formularz_F11" sourceRef="RECZNE_Formularz_send" targetRef="RECZNE_Formularz_end" />
    <bpmn:sequenceFlow id="RECZNE_Formularz_F12" sourceRef="RECZNE_Formularz_status" targetRef="RECZNE_Formularz_draft" name="Nie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nie</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="RECZNE_Przetwarzanie" name="2. Portal — walidacja i nadanie stopnia otwartości w tle" isExecutable="false">
    <bpmn:documentation>Model biznesowy ręcznego dodania zasobu w panelu administracyjnym. Podstawa: lokalny snapshot mcod/backend/2.62.3/98b9855d7b47cb8fd8680ab70c6114f138ac46123ea1541fbce2664866f09578-tree; resources/forms.py, admin.py, models.py i tasks. Analiza statyczna, bez uruchamiania aplikacji. Diagram agreguje dwie ścieżki wejścia w pojedynczy krok zgodnie z prośbą użytkownika. Zapis jako szkic nie uruchamia tego samego przebiegu co zapis opublikowanego zasobu.</bpmn:documentation>
    <bpmn:startEvent id="RECZNE_Przetwarzanie_start" name="Odebrano zlecenie przygotowania">
      <bpmn:outgoing>RECZNE_Przetwarzanie_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="RECZNE_Przetwarzanie_start_MessageEvent" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="RECZNE_Przetwarzanie_url" name="Sprawdź URL i pobierz treść — jeżeli podano URL">
      <bpmn:documentation>Dla URL: URLValidator, HTTPS po przekierowaniu, HTTP 200, Content-Type, rozpoznanie typu i formatu; dla pliku zapis kopii głównej. Dla pliku z dysku etap HTTP nie jest wykonywany: wejście trafia do entrypoint_res_file. Jest to skrót prezentacyjny, nie dodatkowe wywołanie w kodzie.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F1</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_needfile" name="Można wykonać wymaganą kontrolę pliku?" gatewayDirection="Diverging">
      <bpmn:documentation>URL: etap adresu udany, brak odroczonego błędu, typ file albo API z forced_file_type; helper wymaga pliku głównego. Dysk: zapisany plik główny jest kierowany do kontroli. API/WWW bez pliku oraz nieudany URL pomijają kontrolę pliku i tabeli.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F2</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F3</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RECZNE_Przetwarzanie_file" name="Zweryfikuj plik główny">
      <bpmn:documentation>process_resource_res_file_task: analyze_file, format, MIME, kodowanie i archiwum; check_support, błąd nieznanego kodowania CSV. Dla pliku z dysku aktualizuje także link zasobu na adres portalu. Nie oznacza sprawdzenia prawdziwości danych.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F3</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_fileok" name="Kontrola pliku udana?" gatewayDirection="Diverging">
      <bpmn:incoming>RECZNE_Przetwarzanie_F4</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F5</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_table" name="Dane kwalifikują się do przetwarzania?" gatewayDirection="Diverging">
      <bpmn:documentation>Resource.is_data_processable: format CSV/TSV/XLS/XLSX/ODS/SHP (także wnętrze archiwum), istniejący plik główny, instytucja inna niż developer.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F5</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F6</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RECZNE_Przetwarzanie_data" name="Sprawdź dane tabelaryczne i zindeksuj wiersze">
      <bpmn:documentation>process_resource_file_data_task: ustal schemat, resource.data.validate(), resource.data.index(force=True). Wyniki i błędy są zapisywane. Indeks wierszy jest osobny od indeksu opisów zasobów.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F6</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_indexed" name="Zindeksowano dane?" gatewayDirection="Diverging">
      <bpmn:documentation>Kod zleca konwersje, gdy success jest prawdziwe; może istnieć również licznik failed. Nie interpretujemy tej bramki jako gwarancji braku każdego błędu wiersza.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F7</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F8</bpmn:outgoing>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="RECZNE_Przetwarzanie_send" name="Zleć osobne zadanie plików pochodnych">
      <bpmn:documentation>increase_openness_score_task.apply_async_on_commit po sukcesie indeksacji. Nie czekaj na konwersje. Bramka kwalifikacji konwersji jest w osobnym procesie.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F8</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_merge" name="Przejdź do oceny dostępnego stanu" gatewayDirection="Converging">
      <bpmn:incoming>RECZNE_Przetwarzanie_F9</bpmn:incoming>
      <bpmn:incoming>RECZNE_Przetwarzanie_F10</bpmn:incoming>
      <bpmn:incoming>RECZNE_Przetwarzanie_F11</bpmn:incoming>
      <bpmn:incoming>RECZNE_Przetwarzanie_F12</bpmn:incoming>
      <bpmn:incoming>RECZNE_Przetwarzanie_F13</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="RECZNE_Przetwarzanie_score" name="NADAJ STOPIEŃ OTWARTOŚCI">
      <bpmn:documentation>Tu obliczana jest pierwsza ocena. Wywołanie update_resource_openness_score po przewidzianych etapach URL/pliku/danych, również gdy wcześniejsza kontrola się nie powiodła. Wyjątek samego obliczenia może przerwać zadanie; nie wymuszamy 0 za każdy błąd.</bpmn:documentation>
      <bpmn:incoming>RECZNE_Przetwarzanie_F14</bpmn:incoming>
      <bpmn:outgoing>RECZNE_Przetwarzanie_F15</bpmn:outgoing>
      <bpmn:startEvent id="RECZNE_Przetwarzanie_score_start" name="Dostępny stan zasobu po kontrolach">
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_fmt" name="Format zasobu = None?" gatewayDirection="Diverging">
        <bpmn:incoming>RECZNE_Przetwarzanie_score_F1</bpmn:incoming>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F2</bpmn:outgoing>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_zero" name="Przyjmij stopień 0">
        <bpmn:incoming>RECZNE_Przetwarzanie_score_F2</bpmn:incoming>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_main" name="Jest plik główny?" gatewayDirection="Diverging">
        <bpmn:incoming>RECZNE_Przetwarzanie_score_F4</bpmn:incoming>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F5</bpmn:outgoing>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="RECZNE_Przetwarzanie_score_files" name="Oceń wszystkie pliki; wybierz maksimum">
        <bpmn:documentation>Źródło: tab=ocena SECTION-ocena-5; XML O13; U-12. Plik główny i wszystkie pliki pochodne, także stare, jeżeli nadal istnieją. jsonstat jest liczony jak json.</bpmn:documentation>
        <bpmn:incoming>RECZNE_Przetwarzanie_score_F5</bpmn:incoming>
        <bpmn:outgoing>RECZNE_Przetwarzanie_score_F9</bpmn:outgoing>
        <bpmn:startEvent id="RECZNE_Przetwarzanie_score_files_start" name="Lista plików zasobu">
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_next" name="Jest następny plik?" gatewayDirection="Mixed">
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F1</bpmn:incoming>
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F18</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F2</bpmn:outgoing>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F3</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_fmt" name="Ustal format zawartości pliku">
          <bpmn:documentation>compressed_file_format ma pierwszeństwo przed format; jsonstat → json.</bpmn:documentation>
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F2</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F4</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_has" name="Plik ma format?" gatewayDirection="Diverging">
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F4</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F5</bpmn:outgoing>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F6</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_one" name="Przyjmij ocenę pliku 1">
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F5</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F14</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_archive" name="Plik jest archiwum?" gatewayDirection="Diverging">
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F6</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F7</bpmn:outgoing>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F8</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_inspect" name="Sprawdź archiwum i jego zawartość">
          <bpmn:documentation>Źródło: tab=ocena SECTION-ocena-5. Zaszyfrowane → 0. Błąd odczytu → 1. Wiele plików → 1, wyjątki geotiff/shp. Jeden plik → oceniaj wnętrze.</bpmn:documentation>
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F7</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F9</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_result" name="Jaki wynik kontroli archiwum?" gatewayDirection="Diverging">
          <bpmn:incoming>RECZNE_Przetwarzanie_score_files_F9</bpmn:incoming>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F10</bpmn:outgoing>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F11</bpmn:outgoing>
          <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_F12</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_zero" name="Zaszyfrowane: ocena 0">
