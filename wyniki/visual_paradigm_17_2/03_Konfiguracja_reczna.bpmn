          <bpmn:sequenceFlow id="RECZNE_Przetwarzanie_score_files_calc_F2" sourceRef="RECZNE_Przetwarzanie_score_files_calc_format" targetRef="RECZNE_Przetwarzanie_score_files_calc_json" name="JSON">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">JSON</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="RECZNE_Przetwarzanie_score_files_calc_F3" sourceRef="RECZNE_Przetwarzanie_score_files_calc_format" targetRef="RECZNE_Przetwarzanie_score_files_calc_xml" name="XML">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">XML</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="RECZNE_Przetwarzanie_score_files_calc_F4" sourceRef="RECZNE_Przetwarzanie_score_files_calc_format" targetRef="RECZNE_Przetwarzanie_score_files_calc_rdf" name="RDF i pokrewne">
