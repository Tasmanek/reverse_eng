          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="RECZNE_Przetwarzanie_score_files_calc_F6" sourceRef="RECZNE_Przetwarzanie_score_files_calc_json" targetRef="RECZNE_Przetwarzanie_score_files_calc_jlinked" name="Tak">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tak</bpmn:conditionExpression>
