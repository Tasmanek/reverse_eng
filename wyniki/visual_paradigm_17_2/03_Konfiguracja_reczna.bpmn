          </bpmn:serviceTask>
          <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_calc_r4" name="Przyjmij stopień 4">
            <bpmn:incoming>RECZNE_Przetwarzanie_score_files_calc_F15</bpmn:incoming>
