            <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_calc_F5</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_calc_json" name="JSON: odczyt RDF daje niepusty graf?" gatewayDirection="Diverging">
            <bpmn:incoming>RECZNE_Przetwarzanie_score_files_calc_F2</bpmn:incoming>
            <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_calc_F6</bpmn:outgoing>
            <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_calc_F7</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_calc_xml" name="XML: wszystkie elementy mają przestrzenie nazw?" gatewayDirection="Diverging">
            <bpmn:incoming>RECZNE_Przetwarzanie_score_files_calc_F3</bpmn:incoming>
