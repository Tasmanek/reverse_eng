          </bpmn:exclusiveGateway>
          <bpmn:serviceTask id="RECZNE_Przetwarzanie_score_files_calc_default" name="Inny format: użyj oceny z tabeli">
            <bpmn:documentation>PDF/JPG/TXT → 1; XLS/XLSX → 2; CSV/HTML/ODS → 3; format spoza tabeli → 1. Pełna tabela w raporcie źródłowym.</bpmn:documentation>
            <bpmn:incoming>RECZNE_Przetwarzanie_score_files_calc_F5</bpmn:incoming>
            <bpmn:outgoing>RECZNE_Przetwarzanie_score_files_calc_F27</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:exclusiveGateway id="RECZNE_Przetwarzanie_score_files_calc_jlinked" name="Graf łączy różne domeny?" gatewayDirection="Diverging">
            <bpmn:incoming>RECZNE_Przetwarzanie_score_files_calc_F6</bpmn:incoming>
