  <bpmn:collaboration id="VIEW_ckan_coll" name="1. CKAN — import, ocena i publikacja">
    <bpmn:participant id="ckan_setup_pool" name="ADMINISTRATOR I HARMONOGRAM — aktywacja lub należny termin" processRef="ckan_setup" />
    <bpmn:participant id="ckan_import_pool" name="HARWESTER I KATALOG — import metadanych; koniec importu nie czeka na ocenę" processRef="ckan_import" />
    <bpmn:messageFlow id="ckan_flow_238" sourceRef="ckan_sendimport" targetRef="ckan_importstart" />
    <bpmn:messageFlow id="ckan_flow_246" sourceRef="ckan_timersend" targetRef="ckan_importstart" />
    <bpmn:participant id="ckan_dispatch_pool" name="ZAPIS ZASOBU — decyzja o przygotowaniu; zlecenie po zatwierdzeniu transakcji" processRef="ckan_dispatch" />
    <bpmn:messageFlow id="ckan_flow_295" sourceRef="ckan_save" targetRef="ckan_dispatchstart" />
    <bpmn:participant id="ckan_prep_url_pool" name="PRZYGOTOWANIE W TLE — CKAN: link i zapisany format" processRef="ckan_prep_url" />
    <bpmn:messageFlow id="ckan_flow_428" sourceRef="ckan_prepsend" targetRef="ckan_url_start" />
    <bpmn:participant id="ckan_publication_pool" name="PUBLIKACJA W TLE — osobne zadania zależne od zdarzenia zapisu / oceny" processRef="ckan_publication" />
    <bpmn:messageFlow id="ckan_flow_466" sourceRef="ckan_save" targetRef="ckan_pubstart" name="Według zdarzenia zapisu" />
    <bpmn:messageFlow id="ckan_flow_474" sourceRef="ckan_url_refresh" targetRef="ckan_pubstart" name="ES/RDF" />
  </bpmn:collaboration>
