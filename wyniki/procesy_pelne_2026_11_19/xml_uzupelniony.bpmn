  <bpmn:documentation>AS-IS mcod 2.62.3. Pule oznaczają niezależne przebiegi; linie przerywane to zlecenia bez oczekiwania. Widok rozwinięty uzupełnia szczegółowy plik *_szczegoly.bpmn. Nie obejmuje projektowanych blokad i nowej flagi is_archive.</bpmn:documentation>
  <bpmn:process id="xml_setup" isExecutable="false" name="ADMINISTRATOR I HARMONOGRAM — aktywacja lub należny termin">
    <bpmn:serviceTask id="xml_config" name="Skonfiguruj i zapisz źródło XML">
      <bpmn:outgoing>xml_flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_activation" name="Nowe aktywne źródło / aktywacja?">
      <bpmn:incoming>xml_flow_21</bpmn:incoming>
      <bpmn:outgoing>xml_flow_29</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_sendimport" name="Zleć import po zatwierdzeniu zapisu">
      <bpmn:incoming>xml_flow_29</bpmn:incoming>
      <bpmn:outgoing>xml_flow_45</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="xml_setupend" name="Koniec konfiguracji">
      <bpmn:incoming>xml_flow_37</bpmn:incoming>
      <bpmn:incoming>xml_flow_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_21" sourceRef="xml_config" targetRef="xml_activation" />
    <bpmn:sequenceFlow id="xml_flow_29" sourceRef="xml_activation" targetRef="xml_sendimport" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_37" sourceRef="xml_activation" targetRef="xml_setupend" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_45" sourceRef="xml_sendimport" targetRef="xml_setupend" />
    <bpmn:startEvent id="xml_timer" name="Termin przeglądu źródeł">
      <bpmn:outgoing>xml_flow_68</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="xml_due" name="Sprawdź aktywność i termin importu">
      <bpmn:incoming>xml_flow_68</bpmn:incoming>
      <bpmn:outgoing>xml_flow_76</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_duetest" name="Import należny?">
      <bpmn:incoming>xml_flow_76</bpmn:incoming>
      <bpmn:outgoing>xml_flow_84</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_92</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_timersend" name="Zleć import">
      <bpmn:incoming>xml_flow_84</bpmn:incoming>
      <bpmn:outgoing>xml_flow_100</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="xml_timerend" name="Koniec cyklu">
      <bpmn:incoming>xml_flow_92</bpmn:incoming>
      <bpmn:incoming>xml_flow_100</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_68" sourceRef="xml_timer" targetRef="xml_due" />
    <bpmn:sequenceFlow id="xml_flow_76" sourceRef="xml_due" targetRef="xml_duetest" />
    <bpmn:sequenceFlow id="xml_flow_84" sourceRef="xml_duetest" targetRef="xml_timersend" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_92" sourceRef="xml_duetest" targetRef="xml_timerend" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_100" sourceRef="xml_timersend" targetRef="xml_timerend" />
  </bpmn:process>
  <bpmn:process id="xml_import" isExecutable="false" name="HARWESTER I KATALOG — import metadanych; koniec importu nie czeka na ocenę">
    <bpmn:startEvent id="xml_importstart" name="Odebrano zlecenie importu">
      <bpmn:outgoing>xml_flow_148</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xml_active" name="Źródło nadal aktywne?">
      <bpmn:incoming>xml_flow_148</bpmn:incoming>
      <bpmn:outgoing>xml_flow_156</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_164</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_fetch" name="Pobierz XML; sprawdź HTTP, MD5 i XSD">
      <bpmn:incoming>xml_flow_156</bpmn:incoming>
      <bpmn:outgoing>xml_flow_172</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="xml_validate" name="Zweryfikuj cały wykaz i opisy zasobów">
      <bpmn:incoming>xml_flow_172</bpmn:incoming>
      <bpmn:outgoing>xml_flow_178</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_valid" name="Wymagane kontrole poprawne?">
      <bpmn:incoming>xml_flow_178</bpmn:incoming>
      <bpmn:outgoing>xml_flow_186</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_194</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_rules" name="Odczytaj dane, dokumenty, statusy i reguły HVD/DGA">
      <bpmn:incoming>xml_flow_186</bpmn:incoming>
      <bpmn:outgoing>xml_flow_212</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="xml_save" name="Zapisz przyjęte zbiory i każdy zasób; obsłuż sygnały">
      <bpmn:incoming>xml_flow_212</bpmn:incoming>
      <bpmn:outgoing>xml_flow_218</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="xml_sync" name="Wycofaj pozycje nieobecne na przyjętej liście">
      <bpmn:incoming>xml_flow_218</bpmn:incoming>
      <bpmn:outgoing>xml_flow_224</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="xml_result" name="Zapisz wynik, liczniki i koniec importu">
      <bpmn:incoming>xml_flow_224</bpmn:incoming>
      <bpmn:outgoing>xml_flow_230</bpmn:outgoing>
      <bpmn:documentation>CKAN: OK / OK_PARTIAL zależnie od odrzuconych zbiorów. XML: błąd wymaganej walidacji wykazu zatrzymuje przyjęcie; szczegóły i błędy zapisu w *_szczegoly.bpmn.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="xml_importend" name="Koniec importu metadanych">
      <bpmn:incoming>xml_flow_230</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="xml_inputerr" name="Zapisz błąd importu; nie zastępuj katalogu błędnym wykazem">
      <bpmn:incoming>xml_flow_194</bpmn:incoming>
      <bpmn:outgoing>xml_flow_204</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="xml_inputerrend" name="Koniec z błędem / pominięcie">
      <bpmn:incoming>xml_flow_164</bpmn:incoming>
      <bpmn:incoming>xml_flow_204</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_148" sourceRef="xml_importstart" targetRef="xml_active" />
    <bpmn:sequenceFlow id="xml_flow_156" sourceRef="xml_active" targetRef="xml_fetch" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_164" sourceRef="xml_active" targetRef="xml_inputerrend" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_172" sourceRef="xml_fetch" targetRef="xml_validate" />
    <bpmn:sequenceFlow id="xml_flow_178" sourceRef="xml_validate" targetRef="xml_valid" />
    <bpmn:sequenceFlow id="xml_flow_186" sourceRef="xml_valid" targetRef="xml_rules" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_194" sourceRef="xml_valid" targetRef="xml_inputerr" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_204" sourceRef="xml_inputerr" targetRef="xml_inputerrend" />
    <bpmn:sequenceFlow id="xml_flow_212" sourceRef="xml_rules" targetRef="xml_save" />
    <bpmn:sequenceFlow id="xml_flow_218" sourceRef="xml_save" targetRef="xml_sync" />
    <bpmn:sequenceFlow id="xml_flow_224" sourceRef="xml_sync" targetRef="xml_result" />
    <bpmn:sequenceFlow id="xml_flow_230" sourceRef="xml_result" targetRef="xml_importend" />
  </bpmn:process>
  <bpmn:process id="xml_dispatch" isExecutable="false" name="ZAPIS ZASOBU — decyzja o przygotowaniu; zlecenie po zatwierdzeniu transakcji">
    <bpmn:startEvent id="xml_dispatchstart" name="Obsługa zapisu / sygnału zasobu">
      <bpmn:outgoing>xml_flow_271</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xml_condition" name="Stan i zmiana wymagają przygotowania?">
      <bpmn:incoming>xml_flow_271</bpmn:incoming>
      <bpmn:outgoing>xml_flow_279</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_303</bpmn:outgoing>
      <bpmn:documentation>Zapis nie oznacza zawsze nowej oceny. Nowy opublikowany zasób / zmiana linku lub dostępności / właściwa zmiana wymuszonego typu / przywrócenie; nowy główny plik opublikowanego zasobu ma osobny sygnał. Sam opis lub format nie gwarantuje oceny. Zmiana znaków umownych ma odrębną ścieżkę. Szczegółowe warunki w modelu szczegółowym.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_prepsend" name="Zleć właściwe zadanie przygotowania">
      <bpmn:outgoing>xml_flow_287</bpmn:outgoing>
      <bpmn:incoming>xml_flow_303</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="xml_dispatchend" name="Koniec obsługi zapisu">
      <bpmn:incoming>xml_flow_279</bpmn:incoming>
      <bpmn:incoming>xml_flow_287</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_271" sourceRef="xml_dispatchstart" targetRef="xml_condition" />
    <bpmn:sequenceFlow id="xml_flow_279" sourceRef="xml_condition" targetRef="xml_dispatchend" name="Nie — m.in. nowy szkic" />
    <bpmn:sequenceFlow id="xml_flow_287" sourceRef="xml_prepsend" targetRef="xml_dispatchend" />
    <bpmn:sequenceFlow id="xml_flow_303" sourceRef="xml_condition" targetRef="xml_prepsend" name="Tak" />
  </bpmn:process>
  <bpmn:process id="xml_prep_url" isExecutable="false" name="PRZYGOTOWANIE W TLE — URL zasobu XML">
    <bpmn:startEvent id="xml_url_start" name="Odebrano zlecenie">
      <bpmn:outgoing>xml_flow_364</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="xml_url_src" name="Sprawdź URL i rozpoznaj typ; dla pliku zapisz kopię główną">
      <bpmn:incoming>xml_flow_364</bpmn:incoming>
      <bpmn:outgoing>xml_flow_372</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_url_need" name="Można i trzeba kontrolować plik?">
      <bpmn:incoming>xml_flow_372</bpmn:incoming>
      <bpmn:outgoing>xml_flow_380</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_388</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_url_file" name="Sprawdź plik: format, MIME, kodowanie i archiwum">
      <bpmn:incoming>xml_flow_380</bpmn:incoming>
      <bpmn:outgoing>xml_flow_396</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_url_fileok" name="Kontrola pliku udana?">
      <bpmn:incoming>xml_flow_396</bpmn:incoming>
      <bpmn:outgoing>xml_flow_404</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_410</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="xml_url_eligible" name="Dane kwalifikują się do tabeli?">
      <bpmn:incoming>xml_flow_404</bpmn:incoming>
      <bpmn:outgoing>xml_flow_418</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_426</bpmn:outgoing>
      <bpmn:documentation>Plik główny; format zasobu lub wnętrza CSV/TSV/XLS/XLSX/ODS/SHP; instytucja inna niż developer. Bez kwalifikacji pomija się dane tabeli, nie samą ocenę. success może współistnieć z failed; nie oznacza poprawności każdego wiersza.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_url_data" name="Ustal schemat, sprawdź i zindeksuj dane">
      <bpmn:incoming>xml_flow_418</bpmn:incoming>
      <bpmn:outgoing>xml_flow_434</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_url_indexed" name="Wynik indeksacji success dodatni?">
      <bpmn:incoming>xml_flow_434</bpmn:incoming>
      <bpmn:outgoing>xml_flow_442</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_450</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_url_derive" name="Zleć pliki pochodne po zatwierdzeniu indeksacji">
      <bpmn:incoming>xml_flow_442</bpmn:incoming>
      <bpmn:outgoing>xml_flow_458</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="xml_url_score" name="Oblicz i zapisz stopień: pliki albo link">
      <bpmn:incoming>xml_flow_388</bpmn:incoming>
      <bpmn:incoming>xml_flow_410</bpmn:incoming>
      <bpmn:incoming>xml_flow_426</bpmn:incoming>
      <bpmn:incoming>xml_flow_450</bpmn:incoming>
      <bpmn:incoming>xml_flow_458</bpmn:incoming>
      <bpmn:outgoing>xml_flow_464</bpmn:outgoing>
      <bpmn:documentation>Brak wartości formatu całego zasobu: 0. Brak pliku głównego i istniejący link: ocena linku. W przeciwnym razie maksimum ocen pliku głównego i pochodnych. Błąd obliczenia może przerwać zadanie przed nowym zapisem. Reguły archiwów i formatów są rozwinięte w szczegółach. Ocena nie stanowi blokady publikacji w obecnym kodzie.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="xml_url_date" name="Zapisz datę weryfikacji, jeżeli żądana">
      <bpmn:incoming>xml_flow_464</bpmn:incoming>
      <bpmn:outgoing>xml_flow_470</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_url_ok" name="Wymagane etapy udane, bez odroczonych wyjątków?">
      <bpmn:incoming>xml_flow_470</bpmn:incoming>
      <bpmn:outgoing>xml_flow_478</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_484</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="xml_url_pub" name="Nadal opublikowany i nieusunięty?">
      <bpmn:incoming>xml_flow_478</bpmn:incoming>
      <bpmn:outgoing>xml_flow_492</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_500</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_url_refresh" name="Zleć odświeżenie ES/RDF">
      <bpmn:incoming>xml_flow_492</bpmn:incoming>
      <bpmn:outgoing>xml_flow_508</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="xml_url_end" name="Koniec zadania">
      <bpmn:incoming>xml_flow_500</bpmn:incoming>
      <bpmn:incoming>xml_flow_508</bpmn:incoming>
      <bpmn:incoming>xml_flow_516</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="xml_url_problem" name="Zaloguj / zgłoś problem; bez końcowego odświeżenia">
      <bpmn:incoming>xml_flow_484</bpmn:incoming>
      <bpmn:outgoing>xml_flow_516</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="xml_flow_364" sourceRef="xml_url_start" targetRef="xml_url_src" />
    <bpmn:sequenceFlow id="xml_flow_372" sourceRef="xml_url_src" targetRef="xml_url_need" />
    <bpmn:sequenceFlow id="xml_flow_380" sourceRef="xml_url_need" targetRef="xml_url_file" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_388" sourceRef="xml_url_need" targetRef="xml_url_score" name="Nie / brak pliku" />
    <bpmn:sequenceFlow id="xml_flow_396" sourceRef="xml_url_file" targetRef="xml_url_fileok" />
    <bpmn:sequenceFlow id="xml_flow_404" sourceRef="xml_url_fileok" targetRef="xml_url_eligible" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_410" sourceRef="xml_url_fileok" targetRef="xml_url_score" name="Nie — ocena dostępnego stanu" />
    <bpmn:sequenceFlow id="xml_flow_418" sourceRef="xml_url_eligible" targetRef="xml_url_data" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_426" sourceRef="xml_url_eligible" targetRef="xml_url_score" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_434" sourceRef="xml_url_data" targetRef="xml_url_indexed" />
    <bpmn:sequenceFlow id="xml_flow_442" sourceRef="xml_url_indexed" targetRef="xml_url_derive" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_450" sourceRef="xml_url_indexed" targetRef="xml_url_score" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_458" sourceRef="xml_url_derive" targetRef="xml_url_score" />
    <bpmn:sequenceFlow id="xml_flow_464" sourceRef="xml_url_score" targetRef="xml_url_date" />
    <bpmn:sequenceFlow id="xml_flow_470" sourceRef="xml_url_date" targetRef="xml_url_ok" />
    <bpmn:sequenceFlow id="xml_flow_478" sourceRef="xml_url_ok" targetRef="xml_url_pub" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_484" sourceRef="xml_url_ok" targetRef="xml_url_problem" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_492" sourceRef="xml_url_pub" targetRef="xml_url_refresh" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_500" sourceRef="xml_url_pub" targetRef="xml_url_end" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_508" sourceRef="xml_url_refresh" targetRef="xml_url_end" />
    <bpmn:sequenceFlow id="xml_flow_516" sourceRef="xml_url_problem" targetRef="xml_url_end" />
  </bpmn:process>
  <bpmn:process id="xml_conversion" isExecutable="false" name="PLIKI POCHODNE W TLE — wspólny algorytm XML i ręcznego dodania">
    <bpmn:startEvent id="xml_convstart" name="Odebrano zlecenie konwersji">
      <bpmn:outgoing>xml_flow_571</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xml_xls" name="XLS/XLSX, nie linked, są dane i tabela?">
      <bpmn:incoming>xml_flow_571</bpmn:incoming>
      <bpmn:outgoing>xml_flow_579</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_587</bpmn:outgoing>
      <bpmn:documentation>XML: linked to availability=remote; ręczne: linked to zewnętrzny URL. Konwersja do CSV uwzględnia format zasobu lub wnętrza archiwum. Brak linked nie jest warunkiem próby JSON-LD z dostępnego CSV. Pierwsza ocena nie czeka na to zadanie.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_csv" name="Utwórz lub odtwórz pochodny CSV UTF-8">
      <bpmn:incoming>xml_flow_579</bpmn:incoming>
      <bpmn:outgoing>xml_flow_595</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_csvavailable" name="Dostępny CSV do konwersji, poza archiwum?">
      <bpmn:incoming>xml_flow_587</bpmn:incoming>
      <bpmn:incoming>xml_flow_595</bpmn:incoming>
      <bpmn:outgoing>xml_flow_603</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_611</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_jsonld" name="Spróbuj utworzyć / odtworzyć JSON-LD">
      <bpmn:incoming>xml_flow_603</bpmn:incoming>
      <bpmn:outgoing>xml_flow_619</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="xml_archsend" name="Zleć paczkę plików zbioru z opóźnieniem">
      <bpmn:incoming>xml_flow_611</bpmn:incoming>
      <bpmn:incoming>xml_flow_619</bpmn:incoming>
      <bpmn:outgoing>xml_flow_625</bpmn:outgoing>
      <bpmn:documentation>Kod zleca dataset.archive_files po powrocie increase_openness_score, przed warunkowym przeliczeniem oceny; także gdy nie powstał plik. Nieprzechwycony wyjątek wcześniej przerywa tę ścieżkę. Paczka plików to nie projektowana flaga archiwum.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="xml_created" name="Powstał / odtworzono plik pochodny?">
      <bpmn:incoming>xml_flow_625</bpmn:incoming>
      <bpmn:outgoing>xml_flow_633</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_641</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_rescore" name="Ponownie oblicz i zapisz ocenę wszystkich plików">
      <bpmn:incoming>xml_flow_633</bpmn:incoming>
      <bpmn:outgoing>xml_flow_649</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="xml_convpub" name="Nadal opublikowany i nieusunięty?">
      <bpmn:incoming>xml_flow_649</bpmn:incoming>
      <bpmn:outgoing>xml_flow_657</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_665</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="xml_convrefresh" name="Zleć odświeżenie ES/RDF z nową oceną">
      <bpmn:incoming>xml_flow_657</bpmn:incoming>
      <bpmn:outgoing>xml_flow_673</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="xml_convend" name="Koniec konwersji">
      <bpmn:incoming>xml_flow_641</bpmn:incoming>
      <bpmn:incoming>xml_flow_665</bpmn:incoming>
      <bpmn:incoming>xml_flow_673</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_571" sourceRef="xml_convstart" targetRef="xml_xls" />
    <bpmn:sequenceFlow id="xml_flow_579" sourceRef="xml_xls" targetRef="xml_csv" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_587" sourceRef="xml_xls" targetRef="xml_csvavailable" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_595" sourceRef="xml_csv" targetRef="xml_csvavailable" />
    <bpmn:sequenceFlow id="xml_flow_603" sourceRef="xml_csvavailable" targetRef="xml_jsonld" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_611" sourceRef="xml_csvavailable" targetRef="xml_archsend" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_619" sourceRef="xml_jsonld" targetRef="xml_archsend" />
    <bpmn:sequenceFlow id="xml_flow_625" sourceRef="xml_archsend" targetRef="xml_created" />
    <bpmn:sequenceFlow id="xml_flow_633" sourceRef="xml_created" targetRef="xml_rescore" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_641" sourceRef="xml_created" targetRef="xml_convend" name="Nie — bez ponownej oceny" />
    <bpmn:sequenceFlow id="xml_flow_649" sourceRef="xml_rescore" targetRef="xml_convpub" />
    <bpmn:sequenceFlow id="xml_flow_657" sourceRef="xml_convpub" targetRef="xml_convrefresh" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_665" sourceRef="xml_convpub" targetRef="xml_convend" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_673" sourceRef="xml_convrefresh" targetRef="xml_convend" />
  </bpmn:process>
  <bpmn:process id="xml_archive" isExecutable="false" name="PACZKA PLIKÓW ZBIORU — niezależne zadanie">
    <bpmn:startEvent id="xml_archstart" name="Odebrano zlecenie po opóźnieniu">
      <bpmn:outgoing>xml_flow_710</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xml_disk" name="Wystarczające wolne miejsce?">
      <bpmn:incoming>xml_flow_710</bpmn:incoming>
      <bpmn:outgoing>xml_flow_718</bpmn:outgoing>
      <bpmn:outgoing>xml_flow_726</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="xml_build" name="Przygotuj ZIP plików zbioru i zaktualizuj odnośnik">
      <bpmn:incoming>xml_flow_718</bpmn:incoming>
      <bpmn:outgoing>xml_flow_744</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="xml_archend" name="Koniec zadania paczki">
      <bpmn:incoming>xml_flow_736</bpmn:incoming>
      <bpmn:incoming>xml_flow_744</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="xml_nospace" name="Zaloguj brak miejsca; pomiń budowę">
      <bpmn:incoming>xml_flow_726</bpmn:incoming>
      <bpmn:outgoing>xml_flow_736</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="xml_flow_710" sourceRef="xml_archstart" targetRef="xml_disk" />
    <bpmn:sequenceFlow id="xml_flow_718" sourceRef="xml_disk" targetRef="xml_build" name="Tak" />
    <bpmn:sequenceFlow id="xml_flow_726" sourceRef="xml_disk" targetRef="xml_nospace" name="Nie" />
    <bpmn:sequenceFlow id="xml_flow_736" sourceRef="xml_nospace" targetRef="xml_archend" />
    <bpmn:sequenceFlow id="xml_flow_744" sourceRef="xml_build" targetRef="xml_archend" />
  </bpmn:process>
  <bpmn:process id="xml_publication" isExecutable="false" name="PUBLIKACJA W TLE — osobne zadania zależne od zdarzenia zapisu / oceny">
    <bpmn:startEvent id="xml_pubstart" name="Odebrano odpowiednie zlecenie">
      <bpmn:outgoing>xml_flow_773</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="xml_pubtasks" name="Wykonaj zlecone aktualizacje ES/API, RDF i powiadomień">
      <bpmn:incoming>xml_flow_773</bpmn:incoming>
      <bpmn:outgoing>xml_flow_781</bpmn:outgoing>
      <bpmn:documentation>To agregacja niezależnych zadań, a nie ich kolejność. Zapis/zmiana stanu może zlecić publikację przed ukończeniem przygotowania. Końcowe odświeżenie po ocenie zleca ES/RDF, nie automatycznie każdy rodzaj powiadomienia. Szczegóły mapy sygnałów i odbiorców w modelach szczegółowych.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="xml_pubend" name="Koniec danego zadania publikacji">
      <bpmn:incoming>xml_flow_781</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="xml_flow_773" sourceRef="xml_pubstart" targetRef="xml_pubtasks" />
    <bpmn:sequenceFlow id="xml_flow_781" sourceRef="xml_pubtasks" targetRef="xml_pubend" />
  </bpmn:process>
</bpmn:definitions>